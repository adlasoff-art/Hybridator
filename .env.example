# Variables d'environnement serveur (jamais préfixées VITE_ — hors bundle client)

# STT
STT_API_KEY=
STT_PROVIDER=openai
# openai | deepgram | demo
STT_ALLOW_DEMO_SERVER=1
STT_OPENAI_MODEL=whisper-1

# IA générative (prompt→timeline / édition clip) — jamais côté client
# GENERATIVE_API_KEY prioritaire, sinon OPENAI_API_KEY
GENERATIVE_API_KEY=
OPENAI_API_KEY=
GENERATIVE_OPENAI_MODEL=gpt-4o-mini

# Licence
LICENSE_SIGNING_SECRET=
LICENSE_ALLOW_DEV=1

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_STUDIO=
STRIPE_SUCCESS_URL=http://localhost:8080/pricing?checkout=success
STRIPE_CANCEL_URL=http://localhost:8080/pricing?checkout=cancel
STRIPE_WEBHOOK_SECRET=

# Sync persistante + comptes/sessions auth (répertoire serveur ; prêt à remplacer par S3)
SYNC_DATA_DIR=

# Config produit distante (optionnel, préfixe VITE_ = client)
# VITE_PRODUCT_CONFIG_URL=
# VITE_CLOUD_RENDER_URL=
