{
  "name": "hybridator",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @hybridator/web-pwa dev",
    "build": "pnpm --filter @hybridator/web-pwa build",
    "build:dev": "pnpm --filter @hybridator/web-pwa build:dev",
    "preview": "pnpm --filter @hybridator/web-pwa preview",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "eslint packages apps/web-pwa scripts --max-warnings 0",
    "test": "pnpm -r --if-present run test",
    "format": "prettier --write .",
    "check:no-react-core": "node scripts/check-no-react-core.mjs",
    "verify": "pnpm check:no-react-core && pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1"
  }
}
